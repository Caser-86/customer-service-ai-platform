# 生产环境配置

# 安全密钥（必须修改）
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
VISITOR_TOKEN_SECRET=your-visitor-token-secret-at-least-32-chars

# 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-database-password
POSTGRES_DB=customer_service
DATABASE_URL=postgresql://postgres:your-strong-database-password@postgres:5432/customer_service

# Redis配置
REDIS_URL=redis://redis:6379

# MinIO配置
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your-strong-minio-password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-strong-minio-password

# AI配置（可选）
LLM_API_KEY=your-llm-api-key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4

# 应用配置
PORT=3001
CORS_ORIGIN=https://your-domain.com
NODE_ENV=production

# 日志配置
LOG_LEVEL=warn
LOG_FORMAT=json

# 监控配置（可选）
SENTRY_DSN=your-sentry-dsn
APM_SERVER_URL=your-apm-server-url

# 速率限制配置
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
