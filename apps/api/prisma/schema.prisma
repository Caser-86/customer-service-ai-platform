generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantPlan {
  free
  pro
  enterprise
}

enum TenantStatus {
  active
  suspended
  deleted
}

enum UserStatus {
  active
  suspended
  deleted
}

enum UserRole {
  admin
  agent
  supervisor
  viewer
}

enum ConversationStatus {
  open_ai
  queued_human
  assigned_human
  resolved
  closed
}

enum MessageRole {
  visitor
  assistant
  agent
  system
}

enum TicketStatus {
  open
  pending
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum KnowledgeStatus {
  uploaded
  indexing
  indexed
  failed
}

enum AiRunStatus {
  started
  completed
  handoff
  failed
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  plan      TenantPlan   @default(free)
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users              User[]
  visitors           Visitor[]
  conversations      Conversation[]
  messages           Message[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
  aiRuns             AiRun[]
  handoffEvents      HandoffEvent[]
  tickets            Ticket[]
  qaScores           QaScore[]
  auditLogs          AuditLog[]
  botConfigs         BotConfig[]

  @@map("tenants")
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  status       UserStatus @default(active)
  roles        UserRole[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  assignedConversations Conversation[] @relation("AssignedAgent")
  createdTickets    Ticket[]         @relation("TicketCreator")
  assignedTickets   Ticket[]         @relation("TicketAssignee")
  qaScores          QaScore[]        @relation("QaReviewer")
  auditLogs         AuditLog[]       @relation("AuditActor")

  @@unique([tenantId, email])
  @@map("users")
}

model Visitor {
  id         String   @id @default(cuid())
  tenantId   String
  externalId String?
  name       String?
  email      String?
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  conversations Conversation[]

  @@map("visitors")
}

model Conversation {
  id              String             @id @default(cuid())
  tenantId        String
  visitorId       String
  status          ConversationStatus @default(open_ai)
  channel         String             @default("web")
  assignedAgentId String?
  priority        Int                @default(0)
  lastMessageAt   DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  visitor         Visitor          @relation(fields: [visitorId], references: [id])
  assignedAgent   User?            @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  messages        Message[]
  aiRuns          AiRun[]
  handoffEvents   HandoffEvent[]
  tickets         Ticket[]
  qaScores        QaScore[]

  @@map("conversations")
}

model Message {
  id              String      @id @default(cuid())
  tenantId        String
  conversationId  String
  role            MessageRole
  content         String
  citations       Json?
  metadata        Json?
  createdAt       DateTime    @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@map("messages")
}

model KnowledgeDocument {
  id         String          @id @default(cuid())
  tenantId   String
  title      String
  sourceType String          @default("markdown")
  content    String
  status     KnowledgeStatus @default(uploaded)
  version    Int             @default(1)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  chunks  KnowledgeChunk[]

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id           String   @id @default(cuid())
  tenantId     String
  documentId   String
  content      String
  embedding    Unsupported("vector(1536)")?
  tokenCount   Int
  metadata     Json?
  createdAt    DateTime @default(now())

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  document KnowledgeDocument  @relation(fields: [documentId], references: [id])

  @@map("knowledge_chunks")
}

model AiRun {
  id               String      @id @default(cuid())
  tenantId         String
  conversationId   String
  model            String
  confidence       Float?
  status           AiRunStatus
  promptTokens     Int?
  completionTokens Int?
  error            String?
  createdAt        DateTime    @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@map("ai_runs")
}

model HandoffEvent {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  reason         String
  fromState      String
  toState        String
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@map("handoff_events")
}

model Ticket {
  id             String       @id @default(cuid())
  tenantId       String
  conversationId String?
  title          String
  description    String?
  status         TicketStatus @default(open)
  priority       TicketPriority @default(medium)
  creatorId      String
  assigneeId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  creator      User          @relation("TicketCreator", fields: [creatorId], references: [id])
  assignee     User?         @relation("TicketAssignee", fields: [assigneeId], references: [id])

  @@map("tickets")
}

model QaScore {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  score          Float
  riskFlags      Json?
  reviewerId     String?
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
  reviewer     User?        @relation("QaReviewer", fields: [reviewerId], references: [id])

  @@map("qa_scores")
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  actorId      String
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User   @relation("AuditActor", fields: [actorId], references: [id])

  @@map("audit_logs")
}

model BotConfig {
  id                String   @id @default(cuid())
  tenantId          String
  provider          String   @default("mock")
  model             String   @default("gpt-4")
  handoffThreshold  Float    @default(0.3)
  safetyRules       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("bot_configs")
}
